extends SceneTree
func _init():
	var policy = load("F:/codex-project/tudou/mods-unpacked/Codex-Pilot/strategy.gd").new()
	assert(not policy.should_restart(false,true,false,10.0))
	assert(not policy.should_restart(false,true,true,7.9))
	assert(not policy.should_restart(true,true,true,10.0))
	assert(not policy.should_restart(false,false,true,10.0))
	assert(policy.should_restart(false,true,true,8.0))
	var f = File.new()
	assert(f.open("F:/codex-project/tudou/run/previous-combat.json",File.READ)==OK)
	var states = parse_json(f.get_as_text())
	f.close()
	var analysis = policy.analyze(states,17)
	assert(analysis.largest_sampled_hp_drop >= 26)
	assert(analysis.changes.size() >= 2)
	f.open("F:/codex-project/tudou/run/results/imported-wave17-analysis.json",File.WRITE)
	f.store_string(JSON.print(analysis))
	f.close()
	print("PASS recovery: recording/analysis/delay/victory gates; actual wave17 analysis saved")
	quit()
